{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amirabbas",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "70648614-dbd6-4574-9853-159634a09086","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "98671ef6e9e64e81bf56a6ce2e6bc2c7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
